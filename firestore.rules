rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: email, displayName, role (admin|faculty|student), isBlocked, canMaintainMOA, college
    //
    // Collection: moas
    // Fields: hteid, companyName, companyAddress, contactPerson, contactPersonEmail, 
    //         industryType, effectiveDate, expirationDate, status, subStatus, 
    //         endorsedByCollege, isDeleted, createdBy, updatedBy, createdAt, updatedAt
    //
    // Collection: audit_logs
    // Fields: userName, userEmail, operation, moaId, moaName, timestamp, details
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' || 
        (request.auth.token.email == "jcesperanza@neu.edu.ph" && request.auth.token.email_verified == true) ||
        (request.auth.token.email == "alexzagayle.ignacio@neu.edu.ph" && request.auth.token.email_verified == true)
      );
    }

    function isFaculty() {
      return isAuthenticated() && (getUserData().role == 'faculty' || request.auth.token.email == "faculty@neu.edu.ph");
    }

    function isStudent() {
      return isAuthenticated() && (getUserData().role == 'student' || request.auth.token.email == "student@neu.edu.ph");
    }

    function isNotBlocked() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(userPath) || get(userPath).data.isBlocked != true;
    }

    function canMaintainMOA() {
      return isAdmin() || (isFaculty() && getUserData().canMaintainMOA == true);
    }

    function isValidMOA(data) {
      return data.companyName is string && 
             data.moaStatus in ['APPROVED', 'PROCESSING', 'EXPIRED', 'EXPIRING'] &&
             data.status in ['active', 'deleted'] &&
             data.isDeleted is bool;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        (request.resource.data.role == 'student' && request.resource.data.isBlocked == false) ||
        isAdmin()
      );
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId && 
        request.resource.data.role == resource.data.role &&
        request.resource.data.isBlocked == resource.data.isBlocked &&
        request.resource.data.canMaintainMOA == resource.data.canMaintainMOA
      );
      allow delete: if isAdmin();
    }

    match /moa_records/{moaId} {
      allow read: if isAuthenticated() && isNotBlocked() && (
        isAdmin() ||
        (isFaculty() && resource.data.status == 'active') ||
        (isStudent() && resource.data.moaStatus == 'APPROVED' && resource.data.status == 'active')
      );
      
      allow create: if isAuthenticated() && isNotBlocked() && canMaintainMOA() && isValidMOA(request.resource.data);
      allow update: if isAuthenticated() && isNotBlocked() && (
        isAdmin() || 
        (canMaintainMOA() && resource.data.status == 'active' && isValidMOA(request.resource.data))
      );
      allow delete: if isAdmin(); // User said "Delete" action performs server-side update, but also "The Trash System" updates isDeleted.
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin() || (isFaculty() && resource.data.type == 'global');
      allow create: if isAuthenticated() && isNotBlocked();
      allow update, delete: if false;
    }
  }
}
